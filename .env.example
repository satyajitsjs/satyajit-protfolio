# Example environment values. Do not commit a populated .env file.
PORT=4173
SITE_URL=https://example.com
# Store data on a PERSISTENT VOLUME in production. Default is ./data/
DATA_DIR=./data
# Set a unique random token of 16+ characters to enable the private /admin page.
ADMIN_TOKEN=replace-with-a-long-random-private-secret
# Optional HTTPS webhook for contact alerts. Contact requests are stored regardless.
# CONTACT_WEBHOOK_URL=https://your-endpoint.example/webhook
